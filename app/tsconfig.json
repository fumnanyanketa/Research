{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // whisper.rn's exports map has no root entry, which breaks TS "bundler"
    // resolution — point TS at its declarations (Metro resolves it at runtime).
    "paths": {
      "whisper.rn": ["./node_modules/whisper.rn/lib/typescript/index.d.ts"],
      "whisper.rn/*": ["./node_modules/whisper.rn/lib/typescript/*"]
    }
  }
}
